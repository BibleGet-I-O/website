# Server-only. Never expose any of these to the browser.
BIBLEGET_API_URL=https://query.bibleget.io/dev
# The API address the reference at /scalar shows readers, when BIBLEGET_API_URL is an internal one (default: BIBLEGET_API_URL).
# BIBLEGET_API_PUBLIC_URL=
BIBLEGET_READ_KEY=
BIBLEGET_READER_KEY=
AUTH_ZITADEL_ISSUER=
AUTH_ZITADEL_ID=
AUTH_ZITADEL_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
ZITADEL_PROJECT_ID=
# Set to 1 on staging: robots.txt disallows all and proxy.ts sends X-Robots-Tag: noindex at runtime.
SITE_NOINDEX=
# The production origin sitemaps are built from (e.g. https://www.bibleget.io). Leave empty on staging: no sitemap is
# served or named in robots.txt without it, and none ever on SITE_NOINDEX=1.
SITE_CANONICAL_ORIGIN=
